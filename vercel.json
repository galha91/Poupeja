{
  "functions": {
    "pages/api/*.js": {
      "maxDuration": 30
    },
    "pages/api/cron-email-semanal.js": {
      "maxDuration": 60
    },
    "pages/api/cron-validar-urls.js": {
      "maxDuration": 60
    },
    "pages/api/push-enviar.js": {
      "maxDuration": 60
    },
    "pages/api/cron-avisos.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-email-semanal",
      "schedule": "0 8 * * 4"
    },
    {
      "path": "/api/cron-validar-urls",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/push-enviar",
      "schedule": "0 9 * * 4"
    },
    {
      "path": "/api/cron-avisos",
      "schedule": "0 18 * * *"
    }
  ]
}
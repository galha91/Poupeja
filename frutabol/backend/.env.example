# ---------- Base de dados ----------
# Dev local (docker compose up -d):
DATABASE_URL="postgresql://frutabol:frutabol@localhost:5432/frutabol"
# Produção: usa a connection string do Neon (neon.tech) ou Railway.

# ---------- Servidor ----------
PORT=4000
# URL pública do frontend (CORS + redirects de OAuth + links nos emails)
FRONTEND_URL="http://localhost:5173"
# URL pública do backend (links assinados nos downloads)
BACKEND_URL="http://localhost:4000"
NODE_ENV=development

# ---------- Segredos (gera valores longos e aleatórios!) ----------
# ex.: node -e "console.log(crypto.randomBytes(48).toString('hex'))"
JWT_SECRET="muda-me-para-um-segredo-longo"
DOWNLOAD_SECRET="muda-me-tambem-outro-segredo"

# ---------- Admin ----------
# O utilizador registado com este email fica automaticamente ADMIN
ADMIN_EMAIL="admin@exemplo.pt"

# ---------- Email (opcional em dev — sem SMTP, os emails saem na consola) ----------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="FrutaBol <noreply@frutabol.example>"

# ---------- OAuth Google (opcional; sem isto o botão fica escondido) ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- FASE 2 — pagamentos (deixa false no lançamento!) ----------
PAYMENTS_ENABLED=false
# Loja Lemon Squeezy (subdomínio, ex.: "frutabol" para frutabol.lemonsqueezy.com)
LEMONSQUEEZY_STORE=""
# Segredo configurado no webhook do Lemon Squeezy (Settings → Webhooks)
LEMONSQUEEZY_WEBHOOK_SECRET=""
